---
/**
 * Header Doc
 * Tujuan    : Shared layout utama situs — <head> lengkap, anti-FOUC script,
 *             Header (dengan ThemeSwitcher), main slot, Footer.
 * Caller    : Semua halaman di src/pages/ (index, projects, blog, about, 404)
 *             dan layout BlogPost.astro
 * Dependensi: BaseHead, Header, Footer, consts.ts, themes.ts (whitelist tunggal)
 * Main Exports: default Astro component (props: title, description, image?)
 * Side Effects: Inline anti-FOUC script membaca localStorage (guarded try/catch)
 *               & set data-theme sebelum first paint. <html> punya data-theme
 *               default server-rendered sebagai fallback no-JS. Tidak ada island
 *               React di layout — switcher memakai script inline vanilla.
 */
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { THEMES, DEFAULT_THEME } from '../data/themes';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <BaseHead {title} {description} {image} {type} {publishedTime} />

    
    <script is:inline define:vars={{ THEMES, DEFAULT_THEME }}>
      (function () {
        var theme = DEFAULT_THEME;
        try {
          var saved = localStorage.getItem('theme');
          if (THEMES.indexOf(saved) !== -1) theme = saved;
        } catch (e) {
          
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
