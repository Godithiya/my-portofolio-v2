---
/**
 * Header Doc
 * Tujuan    : Layout halaman detail blog — hero image, tanggal, judul, konten MDX.
 *             Memakai BaseLayout agar anti-FOUC script & theme tokens aktif.
 * Caller    : src/pages/blog/[...slug].astro
 * Dependensi: BaseLayout, FormattedDate, Image (astro:assets)
 * Main Exports: default Astro component (props: title, description, pubDate,
 *               updatedDate?, heroImage?) + slot untuk konten
 * Side Effects: Tidak ada (render statis).
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props;
---

<BaseLayout {title} {description} image={heroImage} type="article" publishedTime={pubDate}>
	<article class="mx-auto max-w-3xl">
		{
			heroImage && (
				<div class="mb-8">
					<Image
						width={1020}
						height={510}
						src={heroImage}
						alt={heroImageAlt ?? title}
						class="rounded-theme w-full"
					/>
				</div>
			)
		}
		<header class="post-header">
			<p class="post-meta mb-3 text-sm text-muted-foreground">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="ml-2 italic">
							&middot; Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1 class="text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
		</header>
		<div class="prose prose-neutral max-w-none">
			<slot />
		</div>
	</article>
</BaseLayout>
