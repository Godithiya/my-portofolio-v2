---
/**
 * Header Doc
 * Tujuan    : Halaman detail blog (dynamic route). Generate static path per post;
 *             post dengan draft:true TIDAK di-build sama sekali (SRS BR-02).
 * Caller    : Astro router (route "/blog/:slug")
 * Dependensi: BlogPost layout, getCollection + render (astro:content)
 * Main Exports: getStaticPaths (Astro), default Astro page
 * Side Effects: Tidak ada (render statis saat build).
 */
import { type CollectionEntry, render } from 'astro:content';
import { getPublishedPosts } from '../../data/blog';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
</BlogPost>
