---
/**
 * Header Doc
 * Tujuan    : Menu hamburger untuk mobile/tablet (<lg) — panel slide-down
 *             berisi anchor nav, ThemeSwitcher (agar tetap bisa ganti tema
 *             di layar kecil), dan SocialLinks. Animasi CSS murni (transform
 *             + opacity, menghormati prefers-reduced-motion via global.css).
 * Caller    : src/components/Header.astro (hanya dirender <lg)
 * Dependensi: SocialLinks.astro, ThemeSwitcher.astro
 * Main Exports: default Astro component
 * Side Effects: Script inline vanilla — toggle panel, tutup saat link diklik /
 *               Escape / resize ke ≥lg; set aria-expanded tombol.
 */
import { Menu, X } from '@lucide/astro';
import SocialLinks from './SocialLinks.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';

const NAV_ITEMS = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#blog', label: 'Blog' },
  { href: '/#contact', label: 'Contact' },
];
---

<div class="relative lg:hidden" data-mobile-menu>
  <button
    type="button"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    aria-label="Buka menu"
    class="inline-flex h-10 w-10 items-center justify-center rounded-theme border border-border text-foreground transition-colors hover:text-accent"
  >
    <span class="menu-icon-open"><Menu size={22} aria-hidden="true" /></span>
    <span class="menu-icon-close hidden"><X size={22} aria-hidden="true" /></span>
  </button>

  <div
    id="mobile-menu-panel"
    data-menu-panel
    class="absolute right-0 top-[calc(100%+0.75rem)] z-50 w-72 max-w-[calc(100vw-2rem)] origin-top-right scale-y-95 rounded-theme border border-border bg-background p-6 opacity-0 shadow-theme invisible transition-all duration-200 ease-out data-[open=true]:visible data-[open=true]:scale-y-100 data-[open=true]:opacity-100"
  >
    <nav aria-label="Mobile navigation">
      <ul class="space-y-1">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                data-menu-link
                class="block rounded-theme px-3 py-2.5 text-base font-medium hover:bg-muted hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-6 border-t border-border pt-6">
      <p class="switcher-cta mb-3 text-xs uppercase tracking-widest text-muted-foreground">
        Choose your design
      </p>
      <ThemeSwitcher />
    </div>

    <div class="mt-6 border-t border-border pt-6">
      <SocialLinks size={18} />
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-mobile-menu]').forEach(function (root) {
      var toggle = root.querySelector('[data-menu-toggle]');
      var panel = root.querySelector('[data-menu-panel]');
      var iconOpen = root.querySelector('.menu-icon-open');
      var iconClose = root.querySelector('.menu-icon-close');

      function setOpen(open) {
        panel.setAttribute('data-open', String(open));
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
      }

      toggle.addEventListener('click', function () {
        setOpen(panel.getAttribute('data-open') !== 'true');
      });

      root.querySelectorAll('[data-menu-link]').forEach(function (link) {
        link.addEventListener('click', function () {
          setOpen(false);
        });
      });

      document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && panel.getAttribute('data-open') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });

      document.addEventListener('click', function (ev) {
        if (!root.contains(ev.target) && panel.getAttribute('data-open') === 'true') {
          setOpen(false);
        }
      });

      var mq = window.matchMedia('(min-width: 1024px)');
      mq.addEventListener('change', function (e) {
        if (e.matches) setOpen(false);
      });
    });
  })();
</script>
